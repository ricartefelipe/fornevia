# Fornevia - variáveis de ambiente para desenvolvimento local.
# Copie para .env e gere a chave UMA vez: php artisan key:generate
# A chave deve ser estável por ambiente (ver docs/runbooks/rotacao-app-key.md).

APP_NAME=Fornevia
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE_DISPLAY=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs estruturados em JSON (stderr) com correlação.
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Banco: papel de aplicação (RLS), manutenção (migrations) e relay da outbox.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=fornevia
DB_USERNAME=fornevia_app
DB_PASSWORD=app-local
DB_OWNER_USERNAME=fornevia_owner
DB_OWNER_PASSWORD=owner-local
DB_RELAY_USERNAME=fornevia_relay
DB_RELAY_PASSWORD=relay-local
DB_SSLMODE=prefer
# Somente para o container postgres local (superusuário de bootstrap).
DB_SUPERUSER_PASSWORD=postgres-local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=330
CACHE_STORE=redis
CACHE_PREFIX=fornevia-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63799

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@fornevia.local"
MAIL_FROM_NAME="${APP_NAME}"

# Horizon: e-mails autorizados (separados por vírgula) além de administradores da plataforma.
HORIZON_ALLOWED_EMAILS=

# Pagamentos: cada distribuidor escolhe o simulador ou o Asaas em
# Financeiro > Gateway de pagamento (chave cifrada e token do webhook por
# distribuidor). Aqui ficam o endereço da API e o prazo das chamadas.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_TIMEOUT_SECONDS=15

# Webhooks enviados: assinatura HMAC e proteção contra SSRF.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
WEBHOOKS_TIMEOUT_SECONDS=10

# Content Security Policy.
CSP_ENABLED=true
CSP_REPORT_URI=

VITE_APP_NAME="${APP_NAME}"
