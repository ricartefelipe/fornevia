{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fornevia/fornevia",
    "type": "project",
    "description": "Plataforma SaaS B2B multitenant para vendas corporativas de distribuidores e atacadistas.",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "brick/money": "^0.15.2",
        "dedoc/scramble": "^0.13.55",
        "laravel/fortify": "^1.42",
        "laravel/framework": "^13.42",
        "laravel/horizon": "^5.51",
        "laravel/sanctum": "^4.4",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.15",
        "laravel/dusk": "^8.8",
        "laravel/pint": "^1.32.3",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3.7",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "test": [
            "@php artisan config:clear --ansi",
            "pest --colors=always"
        ],
        "test:unit": "pest --testsuite=Unit",
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "pest --coverage --min=0 --coverage-clover=build/coverage/clover.xml --log-junit=build/junit.xml"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/dusk"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
