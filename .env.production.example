# Fornevia - modelo de variáveis para compose.prod.yaml.
# Copie para .env.production (fora do controle de versão) e preencha.
# Segredos devem vir de um cofre; nunca reutilize os valores de desenvolvimento.

APP_NAME=Fornevia
# Gere uma vez: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
# Chaves anteriores durante a rotação (docs/runbooks/rotacao-app-key.md).
APP_PREVIOUS_KEYS=
APP_URL=https://app.exemplo.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE_DISPLAY=America/Sao_Paulo
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_DATABASE=fornevia
DB_USERNAME=fornevia_app
DB_PASSWORD=
DB_OWNER_USERNAME=fornevia_owner
DB_OWNER_PASSWORD=
DB_RELAY_USERNAME=fornevia_relay
DB_RELAY_PASSWORD=
DB_SUPERUSER_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=330
CACHE_STORE=redis
CACHE_PREFIX=fornevia-cache-
REDIS_CLIENT=phpredis
REDIS_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=nao-responda@exemplo.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Proxy reverso à frente do serviço web (IPs ou faixas confiáveis).
TRUSTED_PROXIES=

HORIZON_ALLOWED_EMAILS=
# Simulador de pagamentos sempre desligado em produção; o gateway é escolhido por distribuidor.
PAYMENTS_SIMULATOR=false
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_TIMEOUT_SECONDS=15

# Métricas Prometheus (/metrics) e hosts internos do coletor.
METRICS_TOKEN=
METRICS_SCRAPE_HOSTS=web
